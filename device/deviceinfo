# ── Kernel ────────────────────────────────────────
# 重要：必须使用厂商或高通下游内核，主线内核 v6.12 不支持 SM8750
# 请替换为实际内核仓库地址，例如：https://github.com/llfzs/8pro-kernel 或厂商源码
deviceinfo_kernel_source="https://git.kernel.org/pub/scm/linux/kernel/git/qcom/linux.git"
deviceinfo_kernel_source_version="for-next"
# defconfig 应使用厂商提供的配置，如 sm8750_defconfig，并通过 fragment 补充
deviceinfo_kernel_defconfig="sm8750_defconfig"
# dtb 名称需与内核编译生成的 dtb 文件名一致，通常为 sm8750-piano.dtb
# 请确认实际文件名（可在内核源码 arch/arm64/boot/dts/qcom/ 目录下查看）
deviceinfo_kernel_dtb_vendor="qcom"
deviceinfo_kernel_dtb_name="sm8750-piano"
deviceinfo_kernel_dtb_override=""

# 内核命令行：移除 video= 参数，保留控制台输出
deviceinfo_kernel_cmdline="console=tty0 console=ttyMSM0,115200n8 earlycon=msm_geni_serial,0xa9c000 root=/dev/block/by-name/userdata rootfstype=ext4 rw init=/sbin/init fbcon=nodefer loglevel=7"

