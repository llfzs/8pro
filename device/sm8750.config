# Qualcomm Snapdragon 8 Elite (SM8750) mainline kernel config fragment
# For Xiaomi Pad 8 Pro (piano) / postmarketOS
# Merged from:
#   - sm8750-mainline/linux v6.16 official sm8750.config
#   - mimoclaw_project piano_defconfig (hardware-specific additions)
#
# Applied on top of mainline arm64 defconfig via merge_config.sh
#
# Validate with:
#   scripts/kconfig/merge_config.sh -m -O out \
#       arch/arm64/configs/defconfig sm8750.config
#   grep "CONFIG_.* not set" out/.config

CONFIG_LOCALVERSION="-sm8750-piano"

# ============================================================
# Boot / DTB
# ============================================================
CONFIG_ARM64_APPENDED_DTB=y

# ============================================================
# NCM (Needed for USB SSH / networking)
# ============================================================
CONFIG_USB_G_NCM=y

# ============================================================
# SoC - Qualcomm SM8750 (sun)
# ============================================================
# SM8750 = Snapdragon 8 Elite: 2x Oryon X2 + 6x Oryon M2 = 8 cores
CONFIG_NR_CPUS=8
CONFIG_SCHED_CLUSTER=y
CONFIG_SCHED_MC=y
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# ============================================================
# Storage / UFS
# ============================================================
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_SCSI_UFS_HPB=y

