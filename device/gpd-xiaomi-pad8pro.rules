# Xiaomi Pad 8 Pro - udev rules
# Input devices
SUBSYSTEM=="input", ATTRS{name}=="xiaomi,pad8pro-touchscreen", ENV{ID_INPUT_TOUCHSCREEN}="1"
SUBSYSTEM=="input", ATTRS{name}=="gpio-keys*", ENV{ID_INPUT_KEY}="1"

# LEDs
SUBSYSTEM=="leds", KERNEL=="*backlight*", ATTR{max_brightness}="4095"

# Power supply
SUBSYSTEM=="power_supply", ATTRS{type}="Battery", ATTR{capacity}+="0"
SUBSYSTEM=="power_supply", ATTRS{type}="USB", ATTR{online}=="1", ENV{PMOS_USB_CONNECTED}="1"

# DRM display
SUBSYSTEM=="drm", KERNEL=="card*", ATTRS{name}=="dsi-1", ENV{DISPLAY}=":0"
