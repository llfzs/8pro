# postmarketOS kernel config fragment for Xiaomi Pad 8 Pro (SM8750)
# 仅补充上游 defconfig 未默认开启的设备专属配置

# ── 启动显示：simplefb + 帧缓冲控制台（启动日志上屏核心） ──
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_CMDLINE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_8x16=y

# DRM 显示与 fbdev 模拟（原生面板驱动加载后接管）
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y

# ── 存储：UFS 物理层补充 ──
CONFIG_PHY_QCOM_QMP_UFS=y

# ── PCIe WiFi ──
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_ATH12K=m
CONFIG_ATH12K_PCI=m

# ── 蓝牙 ──
CONFIG_BT_QCA=m
CONFIG_BT_HCIUART=m
CONFIG_RFKILL=y

# ── 触控 ──
CONFIG_TOUCHSCREEN_FTS=m

# ── 传感器 ──
CONFIG_ST_LSM6DSO=m
CONFIG_LIS2MDL=m

# ── USB 功能补充 ──
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_ROLE_SWITCH=y

# ── 电源与充电 ──
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_BATTERY_QCOM_BMS=y
CONFIG_THERMAL_QCOM_SPMI_ADC_TM5=y

# ── 调试与启动参数 ──
CONFIG_EARLYCON=y
CONFIG_CMDLINE_EXTEND=y
CONFIG_PRINTK=y
CONFIG_ARM64_APPENDED_DTB=y