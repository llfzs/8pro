# postmarketOS kernel config fragment for Xiaomi Pad 8 Pro (SM8750)
# 仅补充上游 defconfig 未默认开启的设备专属配置

# ── 启动显示：simplefb + 帧缓冲控制台（启动日志上屏核心） ──
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_CMDLINE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_8x16=y

# ── DRM 显示与 fbdev 模拟（原生面板驱动加载后接管） ──
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_PANEL=y

# ── DSI 面板驱动 ──
# 小米 Pad 8 Pro 使用双 DSI 面板，需要对应的面板驱动。
# 若主线内核无现成驱动，需自行编写 panel-xiaomi-p81.c。
# 以下为通用 DSI 面板支持：
CONFIG_DRM_MSM_DSI_HELPER=y

# ── GPU — Adreno 830 (a680) ──
# DRM_MSM_GPU 已在上方启用。
# Adreno a680 需要 ZAP shader 固件 (a680_zap.mbn)。
# 固件路径: /lib/firmware/qcom/a680_zap.mbn
CONFIG_DRM_MSM_GPU_STATE=y

# ── 存储：UFS 物理层补充 ──
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFS_QCOM=y

# ── PCIe WiFi (WCN7850) ──
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PCIE_QCOM=y
CONFIG_ATH12K=m
CONFIG_ATH12K_PCI=m

# ── 蓝牙 (WCN7850 via UART HCI) ──
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_QCA=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_RFKILL=y

# ── 触控 — Novatek NT36532 ──
CONFIG_TOUCHSCREEN_FTS=m
# 若主线无 novatek 驱动，需自行编译或使用通用 SPI 触摸框架
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_SPI=y

# ── 背光 — KTZ8866 ──
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_KTZ8866=m

# ── 传感器 ──
CONFIG_ST_LSM6DSO=m
CONFIG_LIS2MDL=m

# ── USB 功能补充 ──
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_DWC3=y
CONFIG_PHY_QCOM_QMP_USB=y

# ── 电源与充电 ──
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_BATTERY_QCOM_BMS=y
CONFIG_THERMAL_QCOM_SPMI_ADC_TM5=y
CONFIG_CHARGER_QCOM_SPMI=y

# ── 调试与启动参数 ──
CONFIG_EARLYCON=y
CONFIG_CMDLINE_EXTEND=y
CONFIG_PRINTK=y
CONFIG_ARM64_APPENDED_DTB=y

# ── GPIO / Pinctrl ──
CONFIG_PINCTRL_SM8750=y
CONFIG_GPIO_SM8750_TLMM=y

# ── I2C / SPI 总线 ──
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
