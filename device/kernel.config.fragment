# Minimal kernel config fragment for Xiaomi Pad 8 Pro
# 目标：串口输出 + UFS 存储 + 基本启动
# 其余外设配置全部移除，验证通过后再逐步添加

# ── 调试与串口 ──
CONFIG_EARLYCON=y
CONFIG_CMDLINE_EXTEND=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_SERIAL_MSM_GENI=y
CONFIG_SERIAL_MSM_GENI_CONSOLE=y

# ── 帧缓冲控制台（可选，串口通了再开） ──
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_CMDLINE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_8x16=y

# ── UFS 存储 ──
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y

# ── 基本块设备 ──
CONFIG_BLK_DEV_SD=y

# ── 文件系统 ──
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y

# ── 启动参数 ──
CONFIG_ARM64_APPENDED_DTB=y
