// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device tree for Xiaomi Pad 8 Pro (SM8750-AB)
 *
 * Based on dmesg from actual device (2026-06-26).
 * Only board-level nodes that don't depend on sm8750.dtsi labels.
 * SoC-level nodes (gpu, mdss, dsi, uart, i2c, pcie, ufs) must be
 * enabled AFTER sm8750.dtsi provides the corresponding labels.
 *
 * Hardware summary (verified from dmesg):
 *   SoC:       SM8750-AB (Snapdragon 8 Elite)
 *   Display:   11.2" 3200x2136 dual-DSI DSC LCD (BOE, panel: xiaomi p81 35 02 0b)
 *   GPU:       Adreno 830 (a680)
 *   WiFi:      WCN7850 (ath12k, PCIe RC0 @ 0x1c00000, CNSS @ 0xb0000000)
 *   BT:        WCN7850 (btqca, UART @ 0x898000 / ttyHS0, GPIO 18)
 *   Touch:     Novatek NT36532 (SPI1 @ 0xa88000, IRQ GPIO 674, lcd_id GPIO 612)
 *   Storage:   UFS @ 0x1d84000
 *   Backlight: ktz8866 x2 (I2C bus 1 @ 0x98c000 addr 0x11, I2C bus 2 @ 0x880000 addr 0x11)
 *   Audio:     fs19xx smartpa x4 (I2C bus 0 @ 0x980000, addr 0x34-0x37)
 *   Debug:     ttyMSM0 @ 0xa9c000 (UART14)
 */

/dts-v1/;

#include "sm8750.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/qcom,rpmh.h>

/ {
	model = "Xiaomi Pad 8 Pro";
	compatible = "qcom,sm8750-piano", "qcom,sm8750";

	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart14;
	};

	chosen {
		bootargs = "console=tty0 console=ttyMSM0,115200n8 earlycon=msm_geni_serial,0xa9c000 root=/dev/block/by-name/userdata rootfstype=ext4 rw init=/sbin/init fbcon=nodefer loglevel=7";
		stdout-path = "serial0";
	};

	/* ── 时钟 ────────────────────────────────────────────
	 * sm8750.dtsi (for-next) 引用了以下标签但未定义，需在此提供：
	 *   xo_board, sleep_clk, bi_tcxo_div2, bi_tcxo_ao_div2
	 */

	xo_board: xo-board {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <38400000>;
	};

	sleep_clk: sleep-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	clocks {
		bi_tcxo_div2: bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;
			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-mult = <1>;
			clock-div = <2>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;
			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
			clock-mult = <1>;
			clock-div = <2>;
		};
	};

	/* ── 电源域 ────────────────────────────────────────── */

	panel_vddio: regulator-panel-vddio {
		compatible = "regulator-fixed";
		regulator-name = "panel_vddio";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		gpio = <&tlmm 45 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_vddio_default>;
	};

	panel_reset: regulator-panel-reset {
		compatible = "regulator-fixed";
		regulator-name = "panel_reset";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&tlmm 46 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_reset_default>;
	};

	wlan_en: regulator-wlan-en {
		compatible = "regulator-fixed";
		regulator-name = "wlan_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tlmm 99 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en_default>;
	};

	/* ── 早期简单帧缓冲 ────────────────────────────────── */

	framebuffer0: framebuffer@fc800000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0xfc800000 0x0 0x02b00000>;
		width = <3200>;
		height = <2136>;
		stride = <12800>;
		format = "a8r8g8b8";
		status = "okay";
	};
};

/* ═══════════════════════════════════════════════════════════
 *  调试串口 — ttyMSM0 @ 0xa9c000 (UART14, GPIO 42/43)
 * ═══════════════════════════════════════════════════════════ */

&uart14 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart14_default>;
};

/* ═══════════════════════════════════════════════════════════
 *  背光 — KTZ8866 x2
 *
 *  dmesg: ktz8866 1-0011 / ktz8866 2-0011
 *  I2C bus 1 (0x98c000) = 主屏, I2C bus 2 (0x880000) = 副屏
 * ═══════════════════════════════════════════════════════════ */

&i2c1 {
	status = "okay";
	clock-frequency = <400000>;

	ktz8866_primary: ktz8866@11 {
		compatible = "ktz8866";
		reg = <0x11>;
		default-brightness = <200>;
		max-brightness = <4095>;
		status = "okay";
	};
};

&i2c2 {
	status = "okay";
	clock-frequency = <400000>;

	ktz8866_secondary: ktz8866@11 {
		compatible = "ktz8866";
		reg = <0x11>;
		default-brightness = <200>;
		max-brightness = <4095>;
		status = "okay";
	};
};

/* ═══════════════════════════════════════════════════════════
 *  音频 — FS19xx SmartPA x4
 *
 *  dmesg: fs16xx 0-0034/0-0035/0-0036/0-0037
 *  I2C bus 0 (0x980000)
 * ═══════════════════════════════════════════════════════════ */

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	fs19xx_0: smartpa@34 {
		compatible = "foursemi,fs19xx";
		reg = <0x34>;
		status = "okay";
	};

	fs19xx_1: smartpa@35 {
		compatible = "foursemi,fs19xx";
		reg = <0x35>;
		status = "okay";
	};

	fs19xx_2: smartpa@36 {
		compatible = "foursemi,fs19xx";
		reg = <0x36>;
		status = "okay";
	};

	fs19xx_3: smartpa@37 {
		compatible = "foursemi,fs19xx";
		reg = <0x37>;
		status = "okay";
	};
};

/* ═══════════════════════════════════════════════════════════
 *  触摸屏 — Novatek NT36532 (SPI1 @ 0xa88000)
 *
 *  dmesg: IRQ GPIO 674, lcd_id GPIO 612 (BOE), pen-support
 * ═══════════════════════════════════════════════════════════ */

&spi1 {
	status = "okay";
	cs-gpios = <&tlmm 0 GPIO_ACTIVE_LOW>;

	touchscreen@0 {
		compatible = "novatek,NVT-ts";
		reg = <0>;
		spi-max-frequency = <19200000>;

		interrupt-parent = <&tlmm>;
		interrupts = <674 IRQ_TYPE_EDGE_FALLING>;

		reset-gpios = <&tlmm 700 GPIO_ACTIVE_LOW>;
		status-gpios = <&tlmm 607 GPIO_ACTIVE_HIGH>;

		vdd-supply = <&panel_vddio>;
		avdd-supply = <&panel_vddio>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_spi_default>;

		touchscreen-size-x = <3200>;
		touchscreen-size-y = <2136>;
		touchscreen-max-pressure = <255>;

		novatek,reset-delay-ms = <10>;
		novatek,pen-support = <1>;
		novatek,lcd-id-gpio = <&tlmm 612 GPIO_ACTIVE_HIGH>;
	};
};

/* ═══════════════════════════════════════════════════════════
 *  传感器 — IMU + 磁力计 (I2C bus 12)
 * ═══════════════════════════════════════════════════════════ */

&i2c12 {
	status = "okay";
	clock-frequency = <400000>;

	imu@68 {
		compatible = "st,lsm6dso";
		reg = <0x68>;
		interrupt-parent = <&tlmm>;
		interrupts = <80 IRQ_TYPE_LEVEL_HIGH>;
	};

	magn@0c {
		compatible = "st,lis2mdl";
		reg = <0x0c>;
	};
};

/* ═══════════════════════════════════════════════════════════
 *  蓝牙 — WCN7850 (UART @ 0x898000, ttyHS0, GPIO 18)
 *
 *  dmesg: btqca.ko + hci_uart.ko, HCI UART QCA registered
 *  注意: UART 节点标签需与 sm8750.dtsi 中的定义匹配。
 *  若 sm8750.dtsi 中不存在 &uart3 标签，需改为路径引用
 *  或移除此节点，等待 dtsi 更新。
 * ═══════════════════════════════════════════════════════════ */

/*
 * 暂时注释：sm8750.dtsi (for-next) 可能尚未定义 uart3 标签。
 * 取消注释前请确认 dtsi 中存在此标签。
 *
 * &uart3 {
 *     status = "okay";
 *     pinctrl-names = "default";
 *     pinctrl-0 = <&uart3_bt_default>;
 *
 *     bluetooth {
 *         compatible = "qcom,wcn7850-bt";
 *         enable-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
 *         max-speed = <3000000>;
 *         status = "okay";
 *     };
 * };
 */

/* ═══════════════════════════════════════════════════════════
 *  UFS 存储 — ufshc @ 0x1d84000
 *
 *  暂时注释：等待 sm8750.dtsi 定义 ufs_mem_hc / ufs_mem_phy 标签。
 *
 *  &ufs_mem_hc { status = "okay"; };
 *  &ufs_mem_phy { status = "okay"; };
 */

/* ═══════════════════════════════════════════════════════════
 *  WiFi — WCN7850 (PCIe RC0 @ 0x1c00000)
 *
 *  暂时注释：等待 sm8750.dtsi 定义 pcie0 / pcie0_phy 标签。
 *
 *  &pcie0 {
 *      status = "okay";
 *      perst-gpios = <&tlmm 100 GPIO_ACTIVE_LOW>;
 *      pinctrl-names = "default";
 *      pinctrl-0 = <&pcie0_default>;
 *      phys = <&pcie0_phy>;
 *      phy-names = "pciephy";
 *      vddpe-supply = <&wlan_en>;
 *  };
 *  &pcie0_phy { status = "okay"; };
 */

/* ═══════════════════════════════════════════════════════════
 *  GPU / 显示 — 等待 sm8750.dtsi 提供标签后启用
 *
 *  需要的标签: &gpu, &mdss, &mdss_mdp, &dsi0, &dsi1,
 *              &dsi0_phy, &dsi1_phy, &gmu
 *
 *  面板 compatible (dmesg 确认):
 *    "qcom,mdss-dsi-p81-35-02-0b-dualdsi-dsc-vid"
 *  panel type: 1 (BOE), topology: lm:2 comp_enc:2 intf:2
 */

/* ═══════════════════════════════════════════════════════════
 *  Pinmux — 所有 GPIO 编号已通过 dmesg 验证
 *
 *  GPIO 45:  panel VDDIO enable
 *  GPIO 46:  panel reset
 *  GPIO 674: touch IRQ
 *  GPIO 612: touch lcd_id (BOE)
 *  GPIO 700: touch reset
 *  GPIO 607: touch status
 *  GPIO 99:  WLAN enable
 *  GPIO 100: PCIe PERST
 *  GPIO 18:  BT enable (WCN7850, 与 WiFi 共享)
 *  GPIO 42/43: debug UART
 * ═══════════════════════════════════════════════════════════ */

&tlmm {
	panel_vddio_default: panel-vddio-default {
		pins = "gpio45";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	panel_reset_default: panel-reset-default {
		pins = "gpio46";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	ts_spi_default: ts-spi-default {
		pins = "gpio674", "gpio700", "gpio607";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	uart14_default: uart14-default {
		pins = "gpio42", "gpio43";
		function = "qup_se5_uart";
		drive-strength = <8>;
		bias-disable;
	};

	/*
	 * BT UART (0x898000) pinmux — 等待确认 QUP SE 编号后启用
	 * uart3_bt_default: uart3-bt-default {
	 *     pins = "gpio16", "gpio17", "gpio18", "gpio19";
	 *     function = "qup_se3_uart";
	 *     drive-strength = <6>;
	 *     bias-pull-up;
	 * };
	 */

	pcie0_default: pcie0-default {
		pins = "gpio100";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	wlan_en_default: wlan-en-default {
		pins = "gpio99";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};
};
