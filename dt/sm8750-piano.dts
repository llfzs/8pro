/*
 * Device tree for Xiaomi Pad 8 Pro (SM8750-AB)
 *
 * Based on dmesg from actual device + Qualcomm SM8750 conventions.
 * Hardware verified from kernel log 2026-06-26.
 *
 * Hardware summary (verified from dmesg):
 *   SoC:       SM8750-AB (Snapdragon 8 Elite)
 *   Display:   11.2" 3200x2136 dual-DSI DSC LCD (BOE, panel: xiaomi p81 35 02 0b)
 *   GPU:       Adreno 830 (a680)
 *   WiFi:      WCN7850 (ath12k, PCIe RC0 @ 0x1c00000, CNSS @ 0xb0000000)
 *   BT:        WCN7850 (btqca, UART @ 0x898000 / ttyHS0, GPIO 18)
 *   Touch:     Novatek NT36532 (SPI1 @ 0xa88000, IRQ GPIO 674, lcd_id GPIO 612)
 *   Storage:   UFS @ 0x1d84000
 *   Backlight: ktz8866 x2 (I2C bus 1 @ 0x98c000 addr 0x11, I2C bus 2 @ 0x880000 addr 0x11)
 *   Audio:     fs19xx smartpa x4 (I2C bus 0 @ 0x980000, addr 0x34-0x37)
 *   Debug:     ttyMSM0 @ 0xa9c000 (UART14)
 */

/dts-v1/;

#include "sm8750.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Xiaomi Pad 8 Pro";
	compatible = "qcom,sm8750-piano", "qcom,sm8750";

	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart14;
	};

	chosen {
		bootargs = "console=tty0 console=ttyMSM0,115200n8 earlycon=msm_geni_serial,0xa9c000 root=/dev/block/by-name/userdata rootfstype=ext4 rw init=/sbin/init fbcon=nodefer loglevel=7";
		stdout-path = "serial0";
	};

	/* ── 板级固定时钟 ──────────────────────────────────── */

	xo_board: xo-board {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <38400000>;
		clock-output-names = "xo_board";
	};

	sleep_clk: sleep-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "sleep_clk";
	};

	/* ── 电源域 ────────────────────────────────────────── */

	/* 面板 VDDIO 稳压器（1.2V） */
	panel_vddio: regulator-panel-vddio {
		compatible = "regulator-fixed";
		regulator-name = "panel_vddio";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		gpio = <&tlmm 45 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_vddio_default>;
	};

	/* 面板复位控制（GPIO 46） */
	panel_reset: regulator-panel-reset {
		compatible = "regulator-fixed";
		regulator-name = "panel_reset";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&tlmm 46 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_reset_default>;
	};

	/* WLAN 电源使能（WCN7850） */
	wlan_en: regulator-wlan-en {
		compatible = "regulator-fixed";
		regulator-name = "wlan_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tlmm 99 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en_default>;
	};

	/* ── 早期简单帧缓冲 ────────────────────────────────── */

	framebuffer0: framebuffer@fc800000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0xfc800000 0x0 0x02b00000>;
		width = <3200>;
		height = <2136>;
		stride = <12800>;
		format = "a8r8g8b8";
		status = "okay";
	};
};

/* ═══════════════════════════════════════════════════════════
 *  串口
 * ═══════════════════════════════════════════════════════════ */

/* UART14 — 调试串口（GENI SE, GPIO 42/43, ttyMSM0 @ 0xa9c000, IRQ 218） */
&uart14 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart14_default>;
};

/* ═══════════════════════════════════════════════════════════
 *  GPU — Adreno 830 (a680)
 * ═══════════════════════════════════════════════════════════ */

&gpu {
	status = "okay";
	qcom,gmu = <&gmu>;
};

/* ═══════════════════════════════════════════════════════════
 *  显示 — MDSS + 双 DSI 面板 (BOE 3200x2136 DSC)
 *
 *  dmesg 确认:
 *    [drm] panel: "xiaomi p81 35 02 0b vid mode dualdsi dsc"
 *    panel type: 1 (BOE, lcd_id GPIO 612 = HIGH)
 *    topology: lm:2 comp_enc:2 intf:2
 *    3 video modes, 120Hz default
 *    panel is tddi
 * ═══════════════════════════════════════════════════════════ */

&mdss {
	status = "okay";
};

&mdss_mdp {
	status = "okay";
};

/* DSI0 — 主控制器 */
&dsi0 {
	status = "okay";
	phys = <&dsi0_phy>;
	phy-names = "dsi";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dsi0_panel_in: endpoint {
				remote-endpoint = <&panel_out0>;
			};
		};
	};

	/* BOE 双 DSI 面板 */
	panel@0 {
		compatible = "qcom,mdss-dsi-p81-35-02-0b-dualdsi-dsc-vid";
		reg = <0>;

		power-supply = <&panel_vddio>;
		reset-gpios = <&tlmm 46 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&panel_reset_default>;

		port {
			panel_out0: endpoint {
				remote-endpoint = <&dsi0_panel_in>;
			};
		};

		display-timings {
			native-mode = <&timing0>;

			timing0: timing0 {
				/* 120Hz 默认模式 */
				clock-frequency = <600000000>;
				hactive = <3200>;
				vactive = <2136>;
				hfront-porch = <40>;
				hback-porch = <40>;
				hsync-len = <4>;
				vfront-porch = <8>;
				vback-porch = <8>;
				vsync-len = <4>;
			};
		};
	};
};

&dsi0_phy {
	status = "okay";
};

/* DSI1 — 从控制器 */
&dsi1 {
	status = "okay";
	phys = <&dsi1_phy>;
	phy-names = "dsi";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dsi1_panel_in: endpoint {
				remote-endpoint = <&panel_out1>;
			};
		};
	};
};

&dsi1_phy {
	status = "okay";
};

/* ═══════════════════════════════════════════════════════════
 *  背光 — KTZ8866 x2 (I2C)
 *
 *  dmesg 确认:
 *    ktz8866 1-0011: probe sucess end   ← I2C bus 1 (0x98c000)
 *    ktz8866 2-0011: probe sucess end   ← I2C bus 2 (0x880000)
 *    两颗 ktz8866 分别控制主/副屏背光
 * ═══════════════════════════════════════════════════════════ */

/* I2C bus 1 (0x98c000) — 主屏背光 */
&i2c1 {
	status = "okay";
	clock-frequency = <400000>;

	ktz8866_primary: ktz8866@11 {
		compatible = "ktz8866";
		reg = <0x11>;
		default-brightness = <200>;
		max-brightness = <4095>;
		status = "okay";
	};
};

/* I2C bus 2 (0x880000) — 副屏背光 */
&i2c2 {
	status = "okay";
	clock-frequency = <400000>;

	ktz8866_secondary: ktz8866@11 {
		compatible = "ktz8866";
		reg = <0x11>;
		default-brightness = <200>;
		max-brightness = <4095>;
		status = "okay";
	};
};

/* ═══════════════════════════════════════════════════════════
 *  音频 — FS19xx SmartPA x4 (I2C bus 0)
 *
 *  dmesg 确认:
 *    fs16xx 0-0034: i2c probe completed  ← I2C bus 0 (0x980000)
 *    fs16xx 0-0035: i2c probe completed
 *    fs16xx 0-0036: i2c probe completed
 *    fs16xx 0-0037: i2c probe completed
 *    四颗 fs19xx 功放芯片驱动四路扬声器
 * ═══════════════════════════════════════════════════════════ */

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	fs19xx_0: smartpa@34 {
		compatible = "foursemi,fs19xx";
		reg = <0x34>;
		status = "okay";
	};

	fs19xx_1: smartpa@35 {
		compatible = "foursemi,fs19xx";
		reg = <0x35>;
		status = "okay";
	};

	fs19xx_2: smartpa@36 {
		compatible = "foursemi,fs19xx";
		reg = <0x36>;
		status = "okay";
	};

	fs19xx_3: smartpa@37 {
		compatible = "foursemi,fs19xx";
		reg = <0x37>;
		status = "okay";
	};
};

/* ═══════════════════════════════════════════════════════════
 *  触摸屏 — Novatek NT36532 (SPI1)
 *
 *  dmesg 确认:
 *    spi_geni a88000.spi: SPI1
 *    [NVT-ts] novatek,irq-gpio=674
 *    [NVT-ts] novatek,lcd_id-gpio=612
 *    [NVT-ts] lcd_id_value = 1, this panel is BOE
 *    [NVT-ts] mode=0, max_speed_hz=19200000
 *    [NVT-ts] Cascade Chip, NVT touch IC
 *    [NVT-ts] novatek,pen-support=1
 * ═══════════════════════════════════════════════════════════ */

&spi1 {
	status = "okay";
	cs-gpios = <&tlmm 0 GPIO_ACTIVE_LOW>;

	touchscreen@0 {
		compatible = "novatek,NVT-ts";
		reg = <0>;
		spi-max-frequency = <19200000>;

		interrupt-parent = <&tlmm>;
		interrupts = <674 IRQ_TYPE_EDGE_FALLING>;

		reset-gpios = <&tlmm 700 GPIO_ACTIVE_LOW>;
		status-gpios = <&tlmm 607 GPIO_ACTIVE_HIGH>;

		vdd-supply = <&panel_vddio>;
		avdd-supply = <&panel_vddio>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_spi_default>;

		touchscreen-size-x = <3200>;
		touchscreen-size-y = <2136>;
		touchscreen-max-pressure = <255>;

		novatek,reset-delay-ms = <10>;
		novatek,pen-support = <1>;
		novatek,lcd-id-gpio = <&tlmm 612 GPIO_ACTIVE_HIGH>;
	};
};

/* ═══════════════════════════════════════════════════════════
 *  传感器 — IMU + 磁力计 (I2C)
 * ═══════════════════════════════════════════════════════════ */

&i2c12 {
	status = "okay";
	clock-frequency = <400000>;

	imu@68 {
		compatible = "st,lsm6dso";
		reg = <0x68>;
		interrupt-parent = <&tlmm>;
		interrupts = <80 IRQ_TYPE_LEVEL_HIGH>;
	};

	magn@0c {
		compatible = "st,lis2mdl";
		reg = <0x0c>;
	};
};

/* ═══════════════════════════════════════════════════════════
 *  蓝牙 — WCN7850 (UART HCI)
 *
 *  dmesg 确认:
 *    898000.qcom,qup_uart: ttyHS0 @ 0x898000 (IRQ 282)
 *    btqca.ko + hci_uart.ko loaded
 *    HCI UART protocol QCA registered
 *    GPIO 18 used by bt_peach (WCN7850 BT)
 *
 *  注意: GPIO 18 被 BT 和 WiFi (cnss-peach) 同时请求，
 *  高通驱动内部处理此冲突，DTS 中不需要额外配置。
 * ═══════════════════════════════════════════════════════════ */

&uart3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart3_bt_default>;

	bluetooth {
		compatible = "qcom,wcn7850-bt";
		enable-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
		max-speed = <3000000>;
		status = "okay";
	};
};

/* ═══════════════════════════════════════════════════════════
 *  UFS 存储
 *
 *  dmesg 确认:
 *    ufshc @ 0x1d84000
 *    ufsphy_mem @ 0x1d80000
 * ═══════════════════════════════════════════════════════════ */

&ufs_mem_hc {
	status = "okay";
};

&ufs_mem_phy {
	status = "okay";
};

/* ═══════════════════════════════════════════════════════════
 *  WiFi — WCN7850 (PCIe)
 *
 *  dmesg 确认:
 *    pci-msm 1c00000.pcie: PCIe RC0
 *    cnss2 b0000000.qcom,cnss-peach
 *    PCIe RC0 link initialized
 *    cnss_wlan_region: 32MB reserved
 * ═══════════════════════════════════════════════════════════ */

&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 100 GPIO_ACTIVE_LOW>;

	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_default>;

	phys = <&pcie0_phy>;
	phy-names = "pciephy";

	vddpe-supply = <&wlan_en>;
};

&pcie0_phy {
	status = "okay";
};

/* ═══════════════════════════════════════════════════════════
 *  Pinmux 配置
 *
 *  GPIO 编号已通过 dmesg 验证:
 *    GPIO 45: panel VDDIO enable
 *    GPIO 46: panel reset
 *    GPIO 674: touch IRQ
 *    GPIO 612: touch lcd_id (BOE panel)
 *    GPIO 700: touch reset
 *    GPIO 607: touch status
 *    GPIO 99: WLAN enable
 *    GPIO 100: PCIe PERST
 *    GPIO 18: BT enable (WCN7850)
 *    GPIO 42/43: debug UART
 * ═══════════════════════════════════════════════════════════ */

&tlmm {
	/* ── 面板 ────────────────────────────────────────── */

	panel_vddio_default: panel-vddio-default {
		pins = "gpio45";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	panel_reset_default: panel-reset-default {
		pins = "gpio46";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	/* ── 触摸屏 ──────────────────────────────────────── */

	ts_spi_default: ts-spi-default {
		pins = "gpio674", "gpio700", "gpio607";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	/* ── 调试串口 (UART14, 0xa9c000) ────────────────── */

	uart14_default: uart14-default {
		pins = "gpio42", "gpio43";
		function = "qup_se5_uart";
		drive-strength = <8>;
		bias-disable;
	};

	/* ── 蓝牙串口 (UART @ 0x898000, ttyHS0) ───────────
	 *  GPIO 16/17 = TX/RX
	 *  GPIO 18 = BT enable (WCN7850, 与 WiFi 共享)
	 *  GPIO 19 = CTS/RTS
	 */
	uart3_bt_default: uart3-bt-default {
		pins = "gpio16", "gpio17", "gpio18", "gpio19";
		function = "qup_se3_uart";
		drive-strength = <6>;
		bias-pull-up;
	};

	/* ── PCIe (WiFi) ─────────────────────────────────── */

	pcie0_default: pcie0-default {
		pins = "gpio100";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	/* ── WLAN 使能 ───────────────────────────────────── */

	wlan_en_default: wlan-en-default {
		pins = "gpio99";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};
};
